{
  "version": 1,
  "families": {
    "i": {"group": "Phone apps", "platforms": ["android"], "android": {"kind": "intent", "target": "$X"}},
    "v": {"group": "Sound & volume", "platforms": ["android"], "android": {"kind": "volume_stream", "stream": "$S", "op": "$O"}},
    "g": {"group": "System navigation", "platforms": ["android"], "android": {"kind": "global", "command": "$C"}},
    "k": {"group": "Clock", "platforms": ["android"], "android": {"kind": "clock", "op": "$O"}}
  },
  "commands": [
    {"id": "app.contacts", "family": "i", "X": "CONTACTS", "title": "Contacts", "phrases": ["(open|show) [my] contacts", "contact list", "my contacts"]},
    {"id": "app.new_contact", "family": "i", "X": "NEW_CONTACT", "title": "Add a contact", "phrases": ["(add|create|save) [a] [new] contact", "new contact"]},
    {"id": "app.new_contact_named", "family": "i", "X": "NEW_CONTACT", "title": "Add a named contact", "phrases": ["(add|create|save) [a] [new] contact (for|named|called) {name}", "save {name} as a [new] contact"], "examples": ["add a new contact named Priya"]},
    {"id": "app.call_log", "family": "i", "X": "CALL_LOG", "title": "Call history", "phrases": ["(show|open|check) [my] (call log|call history|recent calls|missed calls)", "who called me [today]", "did i miss any calls", "missed calls"]},
    {"id": "app.dialer", "family": "i", "X": "DIALER", "title": "Dialer", "phrases": ["open [the] (dialer|dial pad|dialpad|keypad|phone app)", "dial pad", "i want to make a call"]},
    {"id": "app.email", "family": "i", "X": "EMAIL", "title": "Write an email", "phrases": ["(compose|write|draft|start) [a|an] [new] email", "new email"]},
    {"id": "app.email_about", "family": "i", "X": "EMAIL", "title": "Write an email about…", "phrases": ["(compose|write|draft|start) [a|an] [new] email (about|with the subject|with subject|titled|regarding) {subject}"], "examples": ["write an email about the meeting tomorrow"]},
    {"id": "app.messages", "family": "i", "X": "MESSAGING", "title": "Messages", "phrases": ["(open|show|check) [my] (messages|texts|sms|text messages)", "messaging app", "do i have [any] new messages"]},
    {"id": "app.gallery", "family": "i", "X": "GALLERY", "title": "Gallery", "phrases": ["(open|show) [my] (gallery|photos|pictures)", "show me my (photos|pictures|recent photos)"]},
    {"id": "app.music", "family": "i", "X": "MUSIC_APP", "title": "Music player", "phrases": ["open [my|the] music (app|player)", "music player", "open my music"]},
    {"id": "app.calendar", "family": "i", "X": "CALENDAR_APP", "title": "Calendar", "phrases": ["(open|show) [my|the] calendar", "my calendar"]},
    {"id": "app.calendar_today", "family": "i", "X": "CALENDAR_TODAY", "title": "Today's schedule", "phrases": ["what is on my calendar [for] today", "(show|open) [me] [my] (today's|todays) (schedule|calendar|events|agenda)", "my schedule [for] today", "what do i have today", "what is my schedule [like] today"]},
    {"id": "app.calendar_tomorrow", "family": "i", "X": "CALENDAR_TOMORROW", "title": "Tomorrow's schedule", "phrases": ["what is on my calendar [for] tomorrow", "(show|open) [me] [my] (tomorrow's|tomorrows) (schedule|calendar|events|agenda)", "my schedule [for] tomorrow", "what do i have tomorrow"]},
    {"id": "app.browser", "family": "i", "X": "BROWSER", "title": "Browser", "phrases": ["open [the|my] (browser|web browser|internet browser)", "browse the (web|internet)"]},
    {"id": "app.maps", "family": "i", "X": "MAPS_APP", "title": "Maps", "phrases": ["open [the] (maps|map|map app|maps app|google maps)", "show [me] [the] map"]},
    {"id": "app.calculator", "family": "i", "X": "CALCULATOR", "title": "Calculator", "phrases": ["open [the] calculator", "calculator"]},
    {"id": "app.files", "family": "i", "X": "FILES", "title": "Files", "phrases": ["open [my] (files|file manager|file explorer|my files)", "(show|browse) my files"]},
    {"id": "app.downloads", "family": "i", "X": "DOWNLOADS", "title": "Downloads", "phrases": ["(open|show) [my] downloads", "my downloads", "where are my downloads"]},
    {"id": "app.recorder", "family": "i", "X": "RECORDER", "title": "Voice recorder", "phrases": ["open [the] (voice recorder|sound recorder|recorder|audio recorder)", "record [a] (voice memo|voice note|audio)", "start [a] voice (recording|memo)"]},
    {"id": "app.clock", "family": "i", "X": "CLOCK_APP", "title": "Clock app", "phrases": ["open [the] clock [app]", "world clock"]},
    {"id": "vol.media_max", "group": "Sound & volume", "platforms": ["android"], "title": "Maximum volume", "android": {"kind": "volume", "change": "SET", "percent": "100"}, "phrases": ["(max|maximum|full) volume", "volume (max|maximum|full|all the way up)", "turn it all the way up"]},
    {"id": "vol.media_min", "group": "Sound & volume", "platforms": ["android"], "title": "Minimum volume", "android": {"kind": "volume", "change": "SET", "percent": "0"}, "phrases": ["(min|minimum|lowest) volume", "volume (min|minimum|zero|all the way down)"]},
    {"id": "vol.media_half", "group": "Sound & volume", "platforms": ["android"], "title": "Half volume", "android": {"kind": "volume", "change": "SET", "percent": "50"}, "phrases": ["(half|medium) volume", "volume (half|halfway|medium)"]},
    {"id": "vol.ring_up", "family": "v", "S": "RING", "O": "UP", "title": "Ring volume up", "phrases": ["(ring|ringer|ringtone) volume up", "(increase|raise|turn up) [the] (ring|ringer|ringtone) volume", "turn up the ringer"]},
    {"id": "vol.ring_down", "family": "v", "S": "RING", "O": "DOWN", "title": "Ring volume down", "phrases": ["(ring|ringer|ringtone) volume down", "(decrease|lower|turn down) [the] (ring|ringer|ringtone) volume", "turn down the ringer"]},
    {"id": "vol.ring_max", "family": "v", "S": "RING", "O": "MAX", "title": "Ring volume max", "phrases": ["(max|maximum|full) (ring|ringer|ringtone) volume", "(ring|ringer) volume (max|maximum|full)", "make my phone ring (loud|louder)"]},
    {"id": "vol.alarm_up", "family": "v", "S": "ALARM", "O": "UP", "title": "Alarm volume up", "phrases": ["alarm volume up", "(increase|raise|turn up) [the] alarm volume", "make [my] alarm louder"]},
    {"id": "vol.alarm_down", "family": "v", "S": "ALARM", "O": "DOWN", "title": "Alarm volume down", "phrases": ["alarm volume down", "(decrease|lower|turn down) [the] alarm volume", "make [my] alarm quieter"]},
    {"id": "vol.alarm_max", "family": "v", "S": "ALARM", "O": "MAX", "title": "Alarm volume max", "phrases": ["(max|maximum|full) alarm volume", "alarm volume (max|maximum|full)"]},
    {"id": "vol.notif_up", "family": "v", "S": "NOTIFICATION", "O": "UP", "title": "Notification volume up", "phrases": ["notification volume up", "(increase|raise|turn up) [the] notification volume"]},
    {"id": "vol.notif_down", "family": "v", "S": "NOTIFICATION", "O": "DOWN", "title": "Notification volume down", "phrases": ["notification volume down", "(decrease|lower|turn down) [the] notification volume"]},
    {"id": "vol.notif_mute", "family": "v", "S": "NOTIFICATION", "O": "MUTE", "title": "Mute notifications sound", "phrases": ["mute [the] (notification|notifications) [sound|sounds|volume]", "silence [my] notifications"]},
    {"id": "vol.call_up", "family": "v", "S": "CALL", "O": "UP", "title": "Call volume up", "phrases": ["(call|in call|earpiece) volume up", "(increase|raise|turn up) [the] call volume"]},
    {"id": "vol.call_down", "family": "v", "S": "CALL", "O": "DOWN", "title": "Call volume down", "phrases": ["(call|in call|earpiece) volume down", "(decrease|lower|turn down) [the] call volume"]},
    {"id": "ringer.normal", "group": "Sound & volume", "platforms": ["android"], "title": "Ring mode", "android": {"kind": "ringer", "mode": "NORMAL"}, "phrases": ["ring mode", "sound mode", "turn on [the] ringer", "unsilence [my] phone", "take [my|the] phone off (silent|vibrate)", "(turn|switch) off silent mode"]},
    {"id": "ringer.vibrate", "group": "Sound & volume", "platforms": ["android"], "title": "Vibrate mode", "android": {"kind": "ringer", "mode": "VIBRATE"}, "phrases": ["vibrate mode", "(put|set) [my|the] phone (on|to) vibrate", "vibrate only", "switch to vibrate [mode]"]},
    {"id": "ringer.silent", "group": "Sound & volume", "platforms": ["android"], "title": "Silent mode", "android": {"kind": "ringer", "mode": "SILENT"}, "phrases": ["silent mode", "(put|set) [my|the] phone (on|to) silent", "silence [my] phone", "mute [my] ringer", "switch to silent [mode]"]},
    {"id": "media.stop", "group": "Media", "platforms": ["android"], "title": "Stop playback", "android": {"kind": "media", "command": "STOP"}, "phrases": ["stop playback", "stop playing", "stop the (song|video|playback|podcast)"]},
    {"id": "media.fast_forward", "group": "Media", "platforms": ["android"], "title": "Fast forward", "android": {"kind": "media", "command": "FAST_FORWARD"}, "phrases": ["fast forward", "skip ahead", "forward [a bit]"]},
    {"id": "media.rewind", "group": "Media", "platforms": ["android"], "title": "Rewind", "android": {"kind": "media", "command": "REWIND"}, "phrases": ["rewind", "go back a bit", "rewind a bit"]},
    {"id": "media.toggle", "group": "Media", "platforms": ["android"], "title": "Play or pause", "android": {"kind": "media", "command": "TOGGLE"}, "phrases": ["play pause", "toggle (playback|music)", "pause or play"]},
    {"id": "camera.selfie", "group": "Camera", "platforms": ["android"], "title": "Front camera", "android": {"kind": "camera", "mode": "SELFIE"}, "phrases": ["open [the] (front|selfie) camera", "selfie (camera|mode)", "switch to [the] front camera"]},
    {"id": "camera.scan", "group": "Camera", "platforms": ["android"], "title": "Scan a QR code", "android": {"kind": "camera", "mode": "PHOTO"}, "say": "Camera open. Point it at the code.", "phrases": ["scan [a|the] (qr code|qr|barcode|code)", "open [the] (qr scanner|scanner)"]},
    {"id": "camera.video", "group": "Camera", "platforms": ["android"], "title": "Video camera", "android": {"kind": "camera", "mode": "VIDEO"}, "phrases": ["open [the] video camera", "video mode", "shoot a video"]},
    {"id": "clock.alarms", "family": "k", "O": "SHOW_ALARMS", "title": "Show alarms", "phrases": ["(show|list|open) [me] [my|all] alarms", "what alarms do i have", "my alarms"]},
    {"id": "clock.new_alarm", "family": "k", "O": "NEW_ALARM", "title": "Set an alarm (pick the time)", "phrases": ["(set|create|make|add|start) [a|an|new|my|the] alarm", "new alarm"]},
    {"id": "clock.timers", "family": "k", "O": "SHOW_TIMERS", "title": "Show timers", "phrases": ["(show|list|open) [me] [my|all] timers", "what timers do i have", "how much time is left on [my|the] timer"]},
    {"id": "clock.dismiss_alarm", "family": "k", "O": "DISMISS_ALARM", "title": "Dismiss alarm", "phrases": ["(dismiss|turn off|stop) [the|my] alarm", "alarm off"]},
    {"id": "clock.snooze", "family": "k", "O": "SNOOZE_ALARM", "title": "Snooze alarm", "phrases": ["snooze [the|my] [alarm]", "five more minutes"]},
    {"id": "clock.dismiss_timer", "family": "k", "O": "DISMISS_TIMER", "title": "Dismiss timer", "phrases": ["(dismiss|cancel|stop|turn off) [the|my] timer", "timer off"]},
    {"id": "nav.split", "family": "g", "C": "SPLIT_SCREEN", "title": "Split screen", "phrases": ["split screen", "(open|enter|toggle|start) split screen", "two apps at once"]},
    {"id": "nav.power", "family": "g", "C": "POWER_DIALOG", "title": "Power menu", "phrases": ["(show|open) [the] power (menu|options|dialog|button menu)", "power menu"]},
    {"id": "nav.close_shade", "family": "g", "C": "DISMISS_SHADE", "title": "Close notifications", "phrases": ["close [the] (notifications|notification shade|notification panel|quick settings)", "hide [the] notifications"]},
    {"id": "nav.all_apps", "family": "g", "C": "ALL_APPS", "title": "All apps", "phrases": ["show all apps", "open [the] app drawer", "app drawer"]},
    {"id": "nav.scroll_down", "family": "g", "C": "SCROLL_DOWN", "title": "Scroll down", "phrases": ["scroll down", "page down", "go down", "next page"]},
    {"id": "nav.scroll_up", "family": "g", "C": "SCROLL_UP", "title": "Scroll up", "phrases": ["scroll up", "page up", "go up"]},
    {"id": "nav.scroll_left", "family": "g", "C": "SCROLL_LEFT", "title": "Scroll left", "phrases": ["scroll left", "swipe right"]},
    {"id": "nav.scroll_right", "family": "g", "C": "SCROLL_RIGHT", "title": "Scroll right", "phrases": ["scroll right", "swipe left"]}
  ]
}
