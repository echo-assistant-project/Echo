{
  "version": 1,
  "families": {
    "g": {
      "group": "Live info",
      "do": {"kind": "web", "url": "https://www.google.com/search?q=$G"},
      "say": "Here's what I found."
    },
    "fest": {
      "group": "Live info",
      "title": "When is $N",
      "phrases": ["(when is|what date is|when does|when will) $T [this year|start|come|fall|be celebrated]", "$T (date|dates|this year)"],
      "do": {"kind": "web", "url": "https://www.google.com/search?q=$Q+date+this+year"},
      "say": "Here's when $N is this year."
    }
  },
  "commands": [
    {"id": "live.weather", "family": "g", "desktop": {"kind": "net", "op": "WEATHER_NOW", "fallback": "https://www.google.com/search?q=weather"}, "title": "Weather now", "G": "weather", "phrases": ["(what is|how is) the weather [like] [today|now|right now|outside]", "weather [today|now|right now|outside]", "today's weather", "(is it|will it be) (hot|cold|sunny|cloudy|windy) today"]},
    {"id": "live.weather_tomorrow", "family": "g", "desktop": {"kind": "net", "op": "TOMORROW", "fallback": "https://www.google.com/search?q=weather+tomorrow"}, "title": "Weather tomorrow", "G": "weather+tomorrow", "phrases": ["[what is|how is] the weather [going to be] [like] tomorrow", "weather tomorrow", "tomorrow's weather"]},
    {"id": "live.weather_city", "family": "g", "desktop": {"kind": "net", "op": "WEATHER_NOW", "fallback": "https://www.google.com/search?q=weather+in+{q}"}, "title": "Weather in a city", "G": "weather+in+{q}", "phrases": ["[what is|how is] the weather [like] in {q}", "weather (in|for) {q}", "how (hot|cold) is it in {q}", "is it raining in {q}"]},
    {"id": "live.weather_week", "family": "g", "desktop": {"kind": "net", "op": "WEEK", "fallback": "https://www.google.com/search?q=weather+forecast+this+week"}, "title": "Weather forecast", "G": "weather+forecast+this+week", "phrases": ["weather (forecast|this week|for the week|for the weekend)", "[what is the] weekend weather", "what is the forecast [for this week|for the weekend]"]},
    {"id": "live.rain", "family": "g", "desktop": {"kind": "net", "op": "UMBRELLA", "fallback": "https://www.google.com/search?q=will+it+rain+today"}, "title": "Will it rain?", "G": "will+it+rain+today", "phrases": ["(will it|is it going to) rain [today]", "(do|should) i (need|take|carry) an umbrella [today]", "chance of rain [today]"]},
    {"id": "live.temperature", "family": "g", "desktop": {"kind": "net", "op": "WEATHER_NOW", "fallback": "https://www.google.com/search?q=temperature+now"}, "title": "Temperature outside", "G": "temperature+now", "phrases": ["what is the temperature [outside|now|today|right now]", "how (hot|cold) is it [outside|today|right now]", "temperature outside"]},
    {"id": "live.aqi", "family": "g", "desktop": {"kind": "net", "op": "AQI", "fallback": "https://www.google.com/search?q=air+quality+index"}, "title": "Air quality", "G": "air+quality+index", "phrases": ["[what is|how is] [the] (air quality|aqi|pollution level|air pollution) [today|now|outside]", "is the air (clean|bad|good) today"]},
    {"id": "live.aqi_city", "family": "g", "desktop": {"kind": "net", "op": "AQI", "fallback": "https://www.google.com/search?q=air+quality+in+{q}"}, "title": "Air quality in a city", "G": "air+quality+in+{q}", "phrases": ["(air quality|aqi|pollution) in {q}", "(what is|how is) the (air quality|aqi|pollution level|pollution) in {q}"]},
    {"id": "live.sunrise", "family": "g", "desktop": {"kind": "net", "op": "SUNRISE", "fallback": "https://www.google.com/search?q=sunrise+time+today"}, "title": "Sunrise time", "G": "sunrise+time+today", "phrases": ["(what time is|when is) [the] sunrise [today|tomorrow]", "sunrise time [today]"]},
    {"id": "live.sunset", "family": "g", "desktop": {"kind": "net", "op": "SUNSET", "fallback": "https://www.google.com/search?q=sunset+time+today"}, "title": "Sunset time", "G": "sunset+time+today", "phrases": ["(what time is|when is) [the] sunset [today|tomorrow]", "sunset time [today]"]},
    {"id": "live.humidity", "family": "g", "desktop": {"kind": "net", "op": "HUMIDITY", "fallback": "https://www.google.com/search?q=humidity+now"}, "title": "Humidity", "G": "humidity+now", "phrases": ["[what is] [the] humidity [today|now|outside]", "how humid is it [today|outside]"]},
    {"id": "live.uv", "family": "g", "desktop": {"kind": "net", "op": "UV", "fallback": "https://www.google.com/search?q=uv+index+today"}, "title": "UV index", "G": "uv+index+today", "phrases": ["[what is] [the] uv index [today]"]},
    {"id": "live.cricket", "family": "g", "title": "Live cricket score", "G": "live+cricket+score", "phrases": ["[what is the] (cricket score|live cricket score|score of the cricket match)", "cricket scores", "(who is winning|who won) the cricket match"]},
    {"id": "live.india_score", "family": "g", "title": "India match score", "G": "india+cricket+match+score", "phrases": ["(india match|india cricket) score", "[how is] [the] india match [going]", "india score", "(who is winning|who won) the india match"]},
    {"id": "live.ipl_score", "family": "g", "title": "IPL score", "G": "ipl+live+score", "phrases": ["[live] ipl score", "(who is winning|who won) the ipl match", "ipl match today"]},
    {"id": "live.ipl_table", "family": "g", "title": "IPL points table", "G": "ipl+points+table", "phrases": ["ipl (points table|standings)"]},
    {"id": "live.football", "family": "g", "title": "Football scores", "G": "football+scores", "phrases": ["(football|soccer|premier league) (scores|results)"]},
    {"id": "live.f1", "family": "g", "title": "Formula 1 standings", "G": "formula+1+standings", "phrases": ["(f1|formula 1|formula one) (standings|results|race results)"]},
    {"id": "live.nba", "family": "g", "title": "NBA scores", "G": "nba+scores", "phrases": ["nba (scores|results)"]},
    {"id": "live.team_score", "family": "g", "title": "Score of a game", "G": "{q}+score", "phrases": ["[what is the] score of [the] {q}", "{q} score", "what is the {q} score"]},
    {"id": "live.next_match", "family": "g", "title": "Next match", "G": "{q}+next+match", "phrases": ["when (does|do|is) {q} (play|playing) [next]", "when is the next {q} match"]},
    {"id": "live.stock", "family": "g", "title": "Stock price", "G": "{q}+share+price", "phrases": ["[what is the] (stock price|share price) of {q}", "{q} (stock|share) price", "how is {q} stock doing"]},
    {"id": "live.sensex", "family": "g", "title": "Sensex", "G": "sensex+today", "phrases": ["[what is] [the] sensex [today|now]", "how is the sensex [doing] [today]"]},
    {"id": "live.nifty", "family": "g", "title": "Nifty 50", "G": "nifty+50+today", "phrases": ["[what is] [the] nifty [50|fifty] [today|now]", "how is the nifty [doing] [today]"]},
    {"id": "live.market", "family": "g", "title": "Stock market today", "G": "stock+market+today", "phrases": ["how is the [stock] market [doing] [today]", "stock market today"]},
    {"id": "live.gold", "family": "g", "title": "Gold rate", "G": "gold+rate+today", "phrases": ["[what is] [the|today's] gold (rate|price) [today]"]},
    {"id": "live.silver", "family": "g", "title": "Silver rate", "G": "silver+rate+today", "phrases": ["[what is] [the|today's] silver (rate|price) [today]"]},
    {"id": "live.petrol", "family": "g", "title": "Petrol price", "G": "petrol+price+today", "phrases": ["[what is] [the|today's] petrol (price|rate) [today]"]},
    {"id": "live.diesel", "family": "g", "title": "Diesel price", "G": "diesel+price+today", "phrases": ["[what is] [the|today's] diesel (price|rate) [today]"]},
    {"id": "live.bitcoin", "family": "g", "desktop": {"kind": "net", "op": "CRYPTO", "q": "bitcoin", "fallback": "https://www.google.com/search?q=bitcoin+price"}, "title": "Bitcoin price", "G": "bitcoin+price", "phrases": ["[what is] [the] (bitcoin|btc) price [now|today]", "how much is [a] bitcoin [worth]"]},
    {"id": "live.price", "family": "g", "title": "Price of something", "G": "{q}+price", "phrases": ["[what is the] price of {q}", "how much (does|do) {q} cost"]},
    {"id": "live.dollar", "family": "g", "desktop": {"kind": "net", "op": "EXCHANGE", "a": "USD", "b": "INR", "fallback": "https://www.google.com/search?q=usd+to+inr"}, "title": "Dollar rate", "G": "usd+to+inr", "phrases": ["[what is] [the|today's] dollar (rate|price) [today]", "dollar to rupee [rate]"]},
    {"id": "live.flight", "family": "g", "title": "Flight status", "G": "flight+{q}+status", "phrases": ["flight status [of|for] {q}", "(where is|track) flight {q}", "is flight {q} on time"]},
    {"id": "live.train", "family": "g", "title": "Train running status", "G": "train+{q}+running+status", "phrases": ["(train|running|live) status [of|for] [train] {q}", "where is train [number] {q}"]},
    {"id": "live.distance", "family": "g", "title": "Distance to a place", "G": "distance+to+{q}", "phrases": ["(how far is|distance to|what is the distance to) {q}"]},
    {"id": "live.things_to_do", "family": "g", "title": "Things to do in a city", "G": "things+to+do+in+{q}", "phrases": ["(things to do|places to visit|what to do|what to see) in {q}"]},
    {"id": "live.recipe", "family": "g", "title": "Recipe", "G": "{q}+recipe", "phrases": ["(recipe|recipes) (for|of) {q}", "how (to|do i|do you) (make|cook|bake) {q}", "{q} recipe"]},
    {"id": "live.calories", "family": "g", "title": "Calories in food", "G": "calories+in+{q}", "phrases": ["how many calories (are in|in|does) {q} [have]", "calories in {q}"]},
    {"id": "live.nutrition", "family": "g", "title": "Nutrition facts", "G": "{q}+nutrition", "phrases": ["(nutrition|nutritional value|protein) (of|in) {q}", "how much protein (is in|in|does) {q} [have]"]},
    {"id": "live.showtimes", "family": "g", "title": "Movie showtimes", "G": "movies+showtimes+near+me", "phrases": ["[movie] (showtimes|show times) [near me|today]", "what movies are playing [near me|today]"]},
    {"id": "live.showtimes_movie", "family": "g", "title": "Showtimes for a movie", "G": "{q}+showtimes", "phrases": ["(showtimes|show times|tickets) (for|of) {q}"]},
    {"id": "live.trailer", "group": "Live info", "title": "Movie trailer", "phrases": ["[show me|play|watch] [the] trailer (for|of) {q}", "{q} trailer"], "do": {"kind": "web", "url": "https://www.youtube.com/results?search_query={q}+trailer"}, "say": "Here's the trailer for {q}."},
    {"id": "live.release", "family": "g", "title": "Release date", "G": "{q}+release+date", "phrases": ["when (does|did|is|will) {q} (come out|release|releasing)", "release date (of|for) {q}"]},
    {"id": "live.cast", "family": "g", "title": "Cast of a film", "G": "{q}+cast", "phrases": ["(who is in|cast of|who acted in|who stars in|who starred in) {q}"]},
    {"id": "live.who_sings", "family": "g", "title": "Who sings a song", "G": "who+sings+{q}", "phrases": ["who (sings|sang|wrote|composed) [the song] {q}"]},
    {"id": "live.define", "family": "g", "desktop": {"kind": "net", "op": "DEFINE", "fallback": "https://www.google.com/search?q=define+{q}"}, "title": "Define a word", "G": "define+{q}", "phrases": ["define {q}", "(definition|meaning) of {q}", "what does {q} mean", "what is the meaning of {q}"]},
    {"id": "live.antonym", "family": "g", "desktop": {"kind": "net", "op": "ANTONYMS", "fallback": "https://www.google.com/search?q=antonym+of+{q}"}, "title": "Opposite of a word", "G": "antonym+of+{q}", "phrases": ["(antonyms|antonym|opposite) (of|for) {q}", "what is the opposite of {q}"]},
    {"id": "live.pronounce", "family": "g", "title": "Pronounce a word", "G": "how+to+pronounce+{q}", "phrases": ["how (do you|do i|to) (pronounce|say) {q}", "pronounce {q}", "pronunciation of {q}"]},
    {"id": "live.translate", "family": "g", "desktop": {"kind": "net", "op": "TRANSLATE", "fallback": "https://www.google.com/search?q=translate+{q}+to+{l}"}, "title": "Translate a phrase", "G": "translate+{q}+to+{l}", "phrases": ["translate {q} (to|into|in) {l}", "how do (you|i) say {q} in {l}"]},
    {"id": "live.traffic", "group": "Live info", "title": "Traffic near me", "phrases": ["how is the traffic [now|today|near me|right now]", "traffic (near me|now|update|right now)", "show [me] [the] traffic"], "do": {"kind": "maps", "q": "traffic near me"}, "say": "Showing traffic near you."},
    {"id": "live.restaurants_in", "group": "Live info", "title": "Restaurants in a place", "phrases": ["[best|good|top] (restaurants|places to eat) in {q}"], "do": {"kind": "maps", "q": "restaurants in {q}"}, "say": "Showing restaurants in {q}."},
    {"id": "live.where_am_i", "group": "Live info", "title": "Where am I?", "phrases": ["where am i [right now]", "show [me] my [current] location", "show me where i am", "what is my location"], "do": {"kind": "maps", "q": "my location"}, "say": "Showing your location on the map."},
    {"id": "live.find_place", "group": "Live info", "title": "Find a place on the map", "phrases": ["(show|find|locate) {q} on [the] map", "(where is|where's) {q} on the map", "map of {q}"], "do": {"kind": "maps", "q": "{q}"}, "say": "Showing {q} on the map."},
    {"id": "dir.walking", "group": "Directions", "title": "Walking directions", "phrases": ["walking directions to {q}", "how (do i|can i) walk to {q}", "walk me to {q}"], "do": {"kind": "directions", "q": "{q}", "mode": "walking"}, "say": "Walking directions to {q}."},
    {"id": "dir.cycling", "group": "Directions", "title": "Cycling directions", "phrases": ["(cycling|bike|bicycle) directions to {q}", "(cycle|ride my bicycle) to {q}"], "do": {"kind": "directions", "q": "{q}", "mode": "bicycling"}, "say": "Cycling directions to {q}."},
    {"id": "dir.two_wheeler", "group": "Directions", "title": "Two-wheeler directions", "phrases": ["(two wheeler|scooter|motorbike) directions to {q}", "ride to {q}"], "do": {"kind": "directions", "q": "{q}", "mode": "two-wheeler"}, "say": "Two-wheeler directions to {q}."},
    {"id": "dir.transit", "group": "Directions", "title": "Public transport directions", "phrases": ["(transit|bus|train|metro|public transport) directions to {q}", "(take|catch) [the] (bus|train|metro) to {q}", "public transport to {q}"], "do": {"kind": "directions", "q": "{q}", "mode": "transit"}, "say": "Public transport directions to {q}."},
    {"id": "dir.driving", "group": "Directions", "title": "Driving directions", "phrases": ["(driving|car|road) directions to {q}", "how long (is the drive|does it take to drive) to {q}"], "do": {"kind": "directions", "q": "{q}", "mode": "driving"}, "say": "Driving directions to {q}."},
