{
  "version": 1,
  "families": {
    "e": {"group": "Echo", "do": {"kind": "echo", "op": "$O"}},
    "l": {"group": "Lists & notes", "do": {"kind": "list", "op": "$O"}}
  },
  "commands": [
    {"id": "echo.help", "family": "e", "O": "HELP", "title": "What can you do?", "phrases": ["what can you do", "help", "help me", "what can i (say|ask you)", "how do i use you", "what (commands|things) (do you know|can you do)", "(show|list) [me] [all] [your|the] commands"]},
    {"id": "echo.count", "family": "e", "O": "COUNT", "title": "How many commands", "phrases": ["how many commands do you (know|have)", "command count"]},
    {"id": "echo.example", "family": "e", "O": "EXAMPLE", "title": "Teach me a command", "phrases": ["(give me|tell me) an example command", "teach me a command", "surprise me", "random command", "what else can you do"]},
    {"id": "echo.groups", "family": "e", "O": "GROUPS", "title": "Command categories", "phrases": ["what kinds of commands (are there|do you have)", "command (categories|groups)", "list command (categories|groups)"]},
    {"id": "echo.repeat", "family": "e", "O": "REPEAT", "title": "Repeat that", "phrases": ["repeat [that|it]", "say that again", "(what did you say|come again|pardon|sorry what)", "can you repeat that"]},
    {"id": "echo.faster", "family": "e", "O": "VOICE_FASTER", "title": "Speak faster", "phrases": ["(speak|talk) faster", "speed up [your voice|your speech]", "faster [voice|speech]"]},
    {"id": "echo.slower", "family": "e", "O": "VOICE_SLOWER", "title": "Speak slower", "phrases": ["(speak|talk) (slower|more slowly)", "slow down", "slower [voice|speech]"]},
    {"id": "echo.normal_speed", "family": "e", "O": "VOICE_NORMAL", "title": "Normal voice speed", "phrases": ["(normal|reset) (voice speed|speech speed|speed)", "speak normally"]},
    {"id": "echo.mute", "family": "e", "O": "MUTE_REPLIES", "title": "Text-only replies", "phrases": ["mute your voice", "text only mode", "(silent|text only) replies", "mute replies", "do not speak [your] replies", "turn off (your voice|voice replies)", "(do not|stop) (respond|responding|speaking|talking) [out loud|for a while]", "no (speaking|talking)", "be muted [for a while]"]},
    {"id": "echo.unmute", "family": "e", "O": "UNMUTE_REPLIES", "title": "Spoken replies", "phrases": ["unmute your voice", "voice replies on", "turn on (your voice|voice replies)", "speak (again|your replies)", "talk to me again"]},
    {"id": "echo.clear_chat", "family": "e", "O": "CLEAR_CHAT", "title": "New conversation", "phrases": ["clear [the|our] (chat|conversation)", "(new|fresh) (chat|conversation)", "start over", "reset [the] conversation", "let us start over"]},
    {"id": "echo.personas", "family": "e", "O": "LIST_PERSONAS", "title": "List personas", "phrases": ["(what|which) personas (do you have|are there)", "(list|show) [your|the] personas", "who else can you be", "what modes do you have"]},
    {"id": "echo.current_persona", "family": "e", "O": "CURRENT_PERSONA", "title": "Current persona", "phrases": ["which persona is this", "who am i talking to", "what persona are you", "which mode are you in", "what mode is this"]},
    {"id": "echo.routines", "family": "e", "O": "LIST_ROUTINES", "title": "List routines", "phrases": ["(list|show) [me] my routines", "what routines do i have", "my routines"]},
    {"id": "echo.my_name", "family": "e", "O": "WHATS_MY_NAME", "title": "What's my name?", "phrases": ["what is my name", "do you know my name", "who am i", "what do you call me"]},
    {"id": "echo.memory_count", "family": "e", "O": "MEMORY_COUNT", "title": "How much you remember", "phrases": ["how many things do you remember", "memory count", "how much do you remember"]},
    {"id": "echo.auto_memory_off", "family": "e", "O": "AUTO_MEMORY_OFF", "title": "Auto memory off", "phrases": ["(turn off|disable|stop) auto memory", "auto memory off", "stop remembering things automatically"]},
    {"id": "echo.auto_memory_on", "family": "e", "O": "AUTO_MEMORY_ON", "title": "Auto memory on", "phrases": ["(turn on|enable) auto memory", "auto memory on"]},
    {"id": "echo.wake_off", "family": "e", "O": "WAKE_WORD_OFF", "title": "Wake word off", "phrases": ["(turn off|disable) [the] wake word", "wake word off", "stop listening for hey echo", "disable hey echo"]},
    {"id": "echo.wake_on", "family": "e", "O": "WAKE_WORD_ON", "title": "Wake word on", "phrases": ["(turn on|enable) [the] wake word", "wake word on", "enable hey echo"]},
    {"id": "echo.stopwatch_start", "family": "e", "O": "STOPWATCH_START", "title": "Start stopwatch", "phrases": ["start [a|the] stopwatch", "stopwatch start", "start timing"]},
    {"id": "echo.stopwatch_stop", "family": "e", "O": "STOPWATCH_STOP", "title": "Stop stopwatch", "phrases": ["(stop|pause) [the] stopwatch", "stopwatch stop", "stop timing"]},
    {"id": "echo.stopwatch_status", "family": "e", "O": "STOPWATCH_STATUS", "title": "Check stopwatch", "phrases": ["(check|read) [the] stopwatch", "stopwatch time", "how long has it been", "what is the stopwatch at"]},
    {"id": "echo.stopwatch_reset", "family": "e", "O": "STOPWATCH_RESET", "title": "Reset stopwatch", "phrases": ["reset [the] stopwatch", "stopwatch reset"]},
    {"id": "echo.speed", "family": "e", "O": "SPEED", "platforms": ["desktop"], "title": "How fast Echo is (measured)", "phrases": ["how (fast|quick) are you", "how (fast|quick) (is|was) (echo|that)", "(show|what is|what are) [your] (speed|latency|response time|response times)", "[echo] speed (report|check|test)"]},
    {"id": "echo.orb_bigger", "family": "e", "O": "ORB_BIGGER", "title": "Bigger orb", "phrases": ["make [the] orb bigger", "bigger orb", "increase [the] orb size"]},
    {"id": "echo.orb_smaller", "family": "e", "O": "ORB_SMALLER", "title": "Smaller orb", "phrases": ["make [the] orb smaller", "smaller orb", "decrease [the] orb size"]},
    {"id": "echo.orb_hide", "family": "e", "O": "ORB_HIDE", "title": "Hide the orb", "phrases": ["hide [the] [floating] orb", "orb off", "turn off [the] [floating] orb"]},
    {"id": "echo.orb_show", "family": "e", "O": "ORB_SHOW", "title": "Show the orb", "phrases": ["show [the] [floating] orb", "orb on", "bring back [the] orb", "turn on [the] [floating] orb"]},
    {"id": "echo.orb_color", "family": "e", "O": "ORB_COLOR", "title": "Orb colour", "phrases": ["(make|change|set|turn) [the] orb [color|colour] [to] {c}", "orb (color|colour) {c}"], "examples": ["make the orb purple"]},
    {"id": "echo.orb_clearer", "family": "e", "O": "ORB_MORE_TRANSPARENT", "title": "More transparent orb", "phrases": ["make [the] orb more (transparent|see through)", "(more transparent|fainter) orb"]},
    {"id": "echo.orb_solid", "family": "e", "O": "ORB_LESS_TRANSPARENT", "title": "More solid orb", "phrases": ["make [the] orb (less transparent|more solid|solid|brighter)", "(solid|brighter) orb"]},
    {"id": "echo.orb_reset", "family": "e", "O": "ORB_RESET", "title": "Reset the orb", "phrases": ["reset [the] orb"]},
    {"id": "echo.settings", "family": "e", "O": "OPEN_SETTINGS", "title": "Echo settings", "phrases": ["(open|show) [your|the] echo settings", "echo settings", "show your settings", "open your settings"]},
    {"id": "echo.answer", "family": "e", "O": "ANSWER", "title": "Reveal the answer", "phrases": ["(what is|tell me|reveal|show me) the answer", "i give up"]},
    {"id": "list.add", "family": "l", "O": "ADD", "title": "Add to a list", "phrases": ["(add|put) {item} (to|on) [my|the] {l} list", "(add|put) {item} on my list"], "examples": ["add milk and eggs to my shopping list"]},
    {"id": "list.buy", "family": "l", "O": "ADD", "title": "Add to shopping list", "do": {"kind": "list", "op": "ADD", "list": "shopping"}, "phrases": ["i need to buy {item}", "(we are|i am) out of {item}"], "examples": ["we are out of bread"]},
    {"id": "list.todo", "family": "l", "O": "ADD", "title": "Add a to-do", "do": {"kind": "list", "op": "ADD", "list": "to-do"}, "desktop": {"kind": "mcp", "op": "TOOL", "tool": "task_add", "arg": "text", "slot": "item"}, "phrases": ["add [a] (to do|todo|task) {item}", "remind me to {item}"] , "examples": ["remind me to call the bank"]},
    {"id": "list.show", "family": "l", "O": "SHOW", "title": "Read a list", "phrases": ["what is on [my|the] {l} list", "(show|read|open) [me] [my|the] {l} list"], "examples": ["what's on my shopping list"]},
    {"id": "list.remove", "family": "l", "O": "REMOVE", "title": "Remove from a list", "phrases": ["(remove|delete|take|cross off|tick off|cross) {item} (from|off) [my|the] {l} list"], "examples": ["remove milk from my shopping list"]},
    {"id": "list.clear", "family": "l", "O": "CLEAR", "title": "Clear a list", "phrases": ["(clear|empty|delete|erase) [my|the] {l} list"], "examples": ["clear my shopping list"]},
    {"id": "list.lists", "family": "l", "O": "LISTS", "title": "My lists", "phrases": ["what lists do i have", "(show|list) [all] my lists"]},
    {"id": "note.take", "family": "l", "O": "NOTE", "title": "Take a note", "phrases": ["(take|make|write|create) a note [that|saying] {item}", "(jot|write) down {item}"], "examples": ["take a note the wifi router is in the hall"]},
    {"id": "note.read", "family": "l", "O": "NOTES", "title": "Read my notes", "phrases": ["(read|show) [me] my notes", "what are my notes", "show notes"]},
    {"id": "note.last", "family": "l", "O": "LAST_NOTE", "title": "Last note", "phrases": ["(what was|read) my last note", "last note"]},
    {"id": "note.delete", "family": "l", "O": "DELETE_NOTES", "title": "Delete all notes", "phrases": ["(delete|clear|erase) [all] my notes"]},
    {"id": "note.count", "family": "l", "O": "NOTE_COUNT", "title": "Note count", "phrases": ["how many notes do i have"]}
  ]
}
