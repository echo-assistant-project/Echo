{
  "version": 1,
  "commands": [
    {"id": "tool.convert", "group": "Calculate & convert", "title": "Convert units", "do": {"kind": "tool", "tool": "convert"}, "phrases": ["(convert|change) {n} {a} (to|into|in) {b}", "{n} {a} (to|in|into) {b}", "how many {b} (are there in|are in|in|make|is) {n} {a}", "what is {n} {a} in {b}"], "examples": ["convert 5 km to miles", "how many cups in 2 liters", "100 fahrenheit to celsius"]},
    {"id": "tool.currency", "group": "Calculate & convert", "title": "Convert currency (live rate)", "do": {"kind": "tool", "tool": "currency"}, "phrases": ["(convert|change) {n} {a} (to|into|in) {b}", "{n} {a} (to|in|into) {b}", "how much is {n} {a} in {b}", "what is {n} {a} in {b}"], "examples": ["convert 100 dollars to rupees", "50 euros in inr"]},
    {"id": "tool.percent_of", "group": "Calculate & convert", "title": "Percent of a number", "do": {"kind": "tool", "tool": "percent_of"}, "phrases": ["[what is|calculate|whats] {n} percent of {n2}"], "examples": ["what is 18 percent of 250", "15% of 80"]},
    {"id": "tool.what_percent", "group": "Calculate & convert", "title": "What percent is X of Y", "do": {"kind": "tool", "tool": "what_percent"}, "phrases": ["what (percent|percentage) is {n} of {n2}", "{n} is what (percent|percentage) of {n2}", "what percentage of {n2} is {n}"], "examples": ["what percent is 30 of 120"]},
    {"id": "tool.tip", "group": "Calculate & convert", "title": "Tip calculator", "do": {"kind": "tool", "tool": "tip"}, "phrases": ["[calculate|what is] [a|the] {n} percent tip (on|for) {n2}", "[calculate|what is] [a|the] tip (on|for) {n2}", "how much (should i tip|tip) (on|for) {n2}"], "examples": ["calculate a 10 percent tip on 1200", "tip on 80"]},
    {"id": "tool.split", "group": "Calculate & convert", "title": "Split a bill", "do": {"kind": "tool", "tool": "split"}, "phrases": ["split {n2} (between|among|by|into|for) {n} [people|persons|ways|friends]", "split [the|a] bill of {n2} (between|among|by|into) {n} [people|persons|ways|friends]"], "examples": ["split 2400 between 4 people"]},
    {"id": "tool.discount", "group": "Calculate & convert", "title": "Discount price", "do": {"kind": "tool", "tool": "discount"}, "phrases": ["{n} percent off [of] {n2}", "[what is|calculate] [a|the] {n} percent discount on {n2}", "price after [a] {n} percent (off|discount) on {n2}"], "examples": ["30 percent off 1999"]},
    {"id": "tool.emi", "group": "Calculate & convert", "title": "Loan EMI", "do": {"kind": "tool", "tool": "emi"}, "phrases": ["[calculate] [the|my] (emi|monthly payment) (for|on) [a loan of] {n} at {n2} percent [interest] for {n3} {u}"], "examples": ["calculate emi for 500000 at 9 percent for 5 years"]},
    {"id": "tool.bmi", "group": "Calculate & convert", "title": "BMI", "do": {"kind": "tool", "tool": "bmi"}, "phrases": ["[calculate] [my] bmi [for|with|if i weigh|if i am] {n} (kg|kilos|kilograms|kgs) [and|at] [height] {n2} (cm|centimeters|centimetres)", "what is my bmi if i weigh {n} (kg|kilos|kilograms) and [i am|am] {n2} (cm|centimeters|centimetres) [tall]"], "examples": ["calculate my bmi 70 kg 175 cm"]},
    {"id": "tool.sqrt", "group": "Calculate & convert", "title": "Square root", "do": {"kind": "tool", "tool": "sqrt"}, "phrases": ["[what is] [the] square root of {n}", "sqrt [of] {n}"], "examples": ["square root of 144"]},
    {"id": "tool.cube_root", "group": "Calculate & convert", "title": "Cube root", "do": {"kind": "tool", "tool": "cube_root"}, "phrases": ["[what is] [the] cube root of {n}"], "examples": ["cube root of 27"]},
    {"id": "tool.factorial", "group": "Calculate & convert", "title": "Factorial", "do": {"kind": "tool", "tool": "factorial"}, "phrases": ["[what is] {n} factorial", "[what is] [the] factorial of {n}"], "examples": ["5 factorial"]},
    {"id": "tool.is_prime", "group": "Calculate & convert", "title": "Is it prime?", "do": {"kind": "tool", "tool": "is_prime"}, "phrases": ["is {n} [a] prime [number]"], "examples": ["is 97 a prime number", "is 91 prime"]},
    {"id": "tool.average", "group": "Calculate & convert", "title": "Average of numbers", "do": {"kind": "tool", "tool": "average"}, "phrases": ["(what is|calculate|find) the (average|mean) of {l}", "(average|mean) of {l}"], "examples": ["average of 4, 8 and 15"]},
    {"id": "tool.gcd", "group": "Calculate & convert", "title": "Greatest common divisor", "do": {"kind": "tool", "tool": "gcd"}, "phrases": ["[what is] [the] (gcd|hcf|greatest common divisor|highest common factor) of {n} and {n2}"], "examples": ["gcd of 12 and 18"]},
    {"id": "tool.lcm", "group": "Calculate & convert", "title": "Least common multiple", "do": {"kind": "tool", "tool": "lcm"}, "phrases": ["[what is] [the] (lcm|least common multiple|lowest common multiple) of {n} and {n2}"], "examples": ["lcm of 4 and 6"]},
    {"id": "tool.to_roman", "group": "Calculate & convert", "title": "Number to Roman numerals", "do": {"kind": "tool", "tool": "to_roman"}, "phrases": ["[what is] {n} in roman numerals", "(convert|write|change) {n} (to|in|into|as) roman numerals", "roman (numeral|numerals) for {n}", "how do you write {n} in roman numerals"], "examples": ["2026 in roman numerals"]},
    {"id": "tool.from_roman", "group": "Calculate & convert", "title": "Roman numerals to number", "do": {"kind": "tool", "tool": "from_roman"}, "phrases": ["(what is|convert|read) [the] roman numeral {r} [in numbers|to a number|as a number]", "what number is [the roman numeral] {r}"], "examples": ["what is the roman numeral XLII"]},
    {"id": "tool.to_binary", "group": "Calculate & convert", "title": "Number to binary", "do": {"kind": "tool", "tool": "to_binary"}, "phrases": ["[what is] {n} in binary", "(convert|change) {n} (to|into) binary"], "examples": ["42 in binary"]},
    {"id": "tool.to_hex", "group": "Calculate & convert", "title": "Number to hexadecimal", "do": {"kind": "tool", "tool": "to_hex"}, "phrases": ["[what is] {n} in (hex|hexadecimal)", "(convert|change) {n} (to|into) (hex|hexadecimal)"], "examples": ["255 in hex"]},
    {"id": "tool.to_octal", "group": "Calculate & convert", "title": "Number to octal", "do": {"kind": "tool", "tool": "to_octal"}, "phrases": ["[what is] {n} in octal", "(convert|change) {n} (to|into) octal"], "examples": ["64 in octal"]},
    {"id": "tool.from_binary", "group": "Calculate & convert", "title": "Binary to number", "do": {"kind": "tool", "tool": "from_binary"}, "phrases": ["[convert] binary {b} (to|in|into) (decimal|a number|number)", "what is binary {b} in decimal"], "examples": ["binary 101010 to decimal"]},
    {"id": "tool.from_hex", "group": "Calculate & convert", "title": "Hexadecimal to number", "do": {"kind": "tool", "tool": "from_hex"}, "phrases": ["[convert] (hex|hexadecimal) {b} (to|in|into) (decimal|a number|number)", "what is (hex|hexadecimal) {b} in decimal"], "examples": ["hex ff to decimal"]},
    {"id": "tool.time_in", "group": "Time & dates", "title": "Time in a city", "do": {"kind": "tool", "tool": "time_in"}, "phrases": ["(what time is it|what is the time|time|current time|local time|the time) in {c} [right now|now]", "{c} time [now|right now]", "[{x}] (time|times) [now|right now|it is|is it] in {c} [right now|now]", "[{x}] current {c} time [now|right now]"], "examples": ["what time is it in Tokyo", "time in New York"]},
    {"id": "tool.time_diff", "group": "Time & dates", "title": "Time difference", "do": {"kind": "tool", "tool": "time_diff"}, "phrases": ["[what is the] (time difference|difference in time) (between|from) {a} (and|to) {b}", "how many hours ahead is {a} (of|from|than) {b}"], "examples": ["time difference between London and Dubai"]},
    {"id": "tool.time_after", "group": "Time & dates", "title": "Time after a delay", "do": {"kind": "tool", "tool": "time_after"}, "phrases": ["what (time will it be|will the time be) in {n} {u}", "what time (is it|will it be) {n} {u} from now"], "examples": ["what time will it be in 90 minutes"]},
    {"id": "tool.days_until", "group": "Time & dates", "title": "Days until a date", "do": {"kind": "tool", "tool": "days_until"}, "phrases": ["how many days (until|till|to|before|left until|left till|are left until|are there until) {d}", "(days|how long) (until|till) {d}", "countdown to {d}", "how many sleeps (until|till) {d}"], "examples": ["how many days until christmas", "days until 25 december"]},
    {"id": "tool.weeks_until", "group": "Time & dates", "title": "Weeks until a date", "do": {"kind": "tool", "tool": "weeks_until"}, "phrases": ["how many weeks (until|till|to|before|left until) {d}"], "examples": ["how many weeks until new year"]},
    {"id": "tool.days_since", "group": "Time & dates", "title": "Days since a date", "do": {"kind": "tool", "tool": "days_since"}, "phrases": ["how many days (since|have passed since|has it been since) {d}", "how many days ago was {d}", "how long (ago was|has it been since) {d}"], "examples": ["how many days since 1 january"]},
    {"id": "tool.weekday_of", "group": "Time & dates", "title": "Day of the week for a date", "do": {"kind": "tool", "tool": "weekday_of"}, "phrases": ["what day [of the week] (is|was|will be|does|did) {d} [fall on|land on|on]", "which day (is|was|will be) {d}", "is {d} a (monday|tuesday|wednesday|thursday|friday|saturday|sunday)", "what will be [the] day on {d}", "what day is it on {d}", "day on {d}", "what is the date (of|on) {d}"], "examples": ["what day is 15 august", "what day of the week was 1 january 2000"]},
    {"id": "tool.holiday", "group": "Time & dates", "title": "When is a holiday", "do": {"kind": "tool", "tool": "holiday"}, "phrases": ["when is {h} [this year]", "what (date|day) is {h} [this year|on]", "when does {h} (fall|come)"], "examples": ["when is easter", "when is mother's day"]},
    {"id": "tool.date_in", "group": "Time & dates", "title": "Date after a number of days", "do": {"kind": "tool", "tool": "date_in"}, "phrases": ["what (is the date|date is it|date will it be|day will it be|is the day) in {n} {u}", "what is the date {n} {u} from (now|today)", "{n} {u} from (now|today)"], "examples": ["what date will it be in 100 days"]},
    {"id": "tool.tomorrow", "group": "Time & dates", "title": "Tomorrow's date", "do": {"kind": "tool", "tool": "date_rel", "offset": "1"}, "phrases": ["what (day|date) is [it] tomorrow", "what is tomorrow's date", "tomorrow's date", "what day is tomorrow"]},
    {"id": "tool.yesterday", "group": "Time & dates", "title": "Yesterday's date", "do": {"kind": "tool", "tool": "date_rel", "offset": "-1"}, "phrases": ["what (day|date) was [it] yesterday", "what was yesterday's date", "yesterday's date"]},
    {"id": "tool.day_after", "group": "Time & dates", "title": "Day after tomorrow", "do": {"kind": "tool", "tool": "date_rel", "offset": "2"}, "phrases": ["what (day|date) is [it] the day after tomorrow", "day after tomorrow"]},
    {"id": "tool.month", "group": "Time & dates", "title": "Current month", "do": {"kind": "tool", "tool": "now_part", "part": "month"}, "phrases": ["(what|which) month is it [now]", "what is the [current] month", "current month"]},
    {"id": "tool.year", "group": "Time & dates", "title": "Current year", "do": {"kind": "tool", "tool": "now_part", "part": "year"}, "phrases": ["(what|which) year is it [now]", "what is the [current] year", "current year"]},
    {"id": "tool.quarter", "group": "Time & dates", "title": "Current quarter", "do": {"kind": "tool", "tool": "now_part", "part": "quarter"}, "phrases": ["(what|which) quarter (is it|are we in)", "current quarter"]},
    {"id": "tool.week_number", "group": "Time & dates", "title": "Week number", "do": {"kind": "tool", "tool": "week_number"}, "phrases": ["(what|which) week (is it|number is it|of the year is it)", "[what is the] week number", "what is the week [today|now]"]},
    {"id": "tool.day_of_year", "group": "Time & dates", "title": "Day of the year", "do": {"kind": "tool", "tool": "day_of_year"}, "phrases": ["(what|which) day of the year is it", "day of the year"]},
    {"id": "tool.days_left_year", "group": "Time & dates", "title": "Days left this year", "do": {"kind": "tool", "tool": "days_left_year"}, "phrases": ["how many days (are left|left) (in|this) year", "how many days (are left|left) in the year", "days left (this year|in the year)", "how many days until the end of the year"]},
    {"id": "tool.leap_year", "group": "Time & dates", "title": "Leap year check", "do": {"kind": "tool", "tool": "leap_year"}, "phrases": ["is {n} a leap year", "is (this year|it) a leap year [this year]"], "examples": ["is 2028 a leap year", "is this year a leap year"]},
    {"id": "tool.days_in_month", "group": "Time & dates", "title": "Days in a month", "do": {"kind": "tool", "tool": "days_in_month"}, "phrases": ["how many days (are there in|are in|in|does) {m} [have]", "days in {m}"], "examples": ["how many days in february"]},
    {"id": "tool.is_weekend", "group": "Time & dates", "title": "Is it the weekend?", "do": {"kind": "tool", "tool": "is_weekend"}, "phrases": ["is it [the] weekend [yet]", "is today [a] (weekend|weekday)", "is it a weekday"]},
    {"id": "tool.moon_phase", "group": "Time & dates", "title": "Moon phase", "do": {"kind": "tool", "tool": "moon_phase"}, "phrases": ["what is the moon phase [today|tonight]", "moon phase [today|tonight]", "what phase is the moon [in] [today|tonight]", "how is the moon tonight"]},
    {"id": "tool.full_moon", "group": "Time & dates", "title": "Full moon?", "do": {"kind": "tool", "tool": "full_moon"}, "phrases": ["is (it|there) a full moon [today|tonight]", "is tonight a full moon", "when is the next full moon"]},
    {"id": "tool.zodiac", "group": "Time & dates", "title": "Zodiac sign", "do": {"kind": "tool", "tool": "zodiac"}, "phrases": ["what is the (zodiac|star|horoscope) sign (for|of) [someone born on] {d}", "what (zodiac|star) sign is {d}", "(zodiac|star) sign for {d}"], "examples": ["what zodiac sign is 15 march"]},
    {"id": "tool.chinese_zodiac", "group": "Time & dates", "title": "Chinese zodiac", "do": {"kind": "tool", "tool": "chinese_zodiac"}, "phrases": ["[what is the] chinese zodiac [animal] (for|of) {n}", "what chinese zodiac is {n}"], "examples": ["chinese zodiac for 1998"]},
    {"id": "tool.age", "group": "Time & dates", "title": "Age from a birth date", "do": {"kind": "tool", "tool": "age"}, "phrases": ["how old is someone born (on|in) {d}", "how old am i if i was born (on|in) {d}", "age of someone born (on|in) {d}"], "examples": ["how old is someone born on 15 march 1998"]},
    {"id": "tool.alarm_in", "group": "Clock", "title": "Alarm in N minutes", "platforms": ["android"], "do": {"kind": "tool", "tool": "alarm_in"}, "phrases": ["(set|create) (an|a) alarm (in|for) {n} {u} [from now]", "wake me [up] in {n} {u}", "alarm in {n} {u}", "(alert|remind|ping|notify|buzz) me in {n} {u}", "(set|create|make) [a|an] alarm (for|in) {n} {u} from now"], "examples": ["set an alarm in 20 minutes", "wake me up in 2 hours"]},
    {"id": "tool.alarm_days", "group": "Clock", "title": "Repeating alarm", "platforms": ["android"], "do": {"kind": "tool", "tool": "alarm_days"}, "phrases": ["(set|create) [a|an] [repeating|recurring|daily] alarm (for|at) {t} (on|every) {days}", "wake me [up] at {t} (on|every) {days}", "(set|create) [a|an] alarm (on|every) {days} at {t}"], "examples": ["set an alarm for 6:30 am on weekdays", "wake me up at 7 every monday and wednesday"]},
    {"id": "tool.count_to", "group": "Fun", "title": "Count to a number", "do": {"kind": "tool", "tool": "count_to"}, "phrases": ["count (to|up to) {n}"], "examples": ["count to 10"]},
    {"id": "tool.random_number", "group": "Fun", "title": "Random number", "do": {"kind": "tool", "tool": "random_number"}, "phrases": ["(pick|give me|generate|choose|tell me|say) a random number", "random number"]},
    {"id": "tool.random_range", "group": "Fun", "title": "Random number in a range", "do": {"kind": "tool", "tool": "random_number"}, "phrases": ["(pick|give me|generate|choose) a [random] number (between|from) {n} (and|to) {n2}", "random number (between|from) {n} (and|to) {n2}"], "examples": ["pick a number between 1 and 10"]},
    {"id": "tool.coin", "group": "Fun", "title": "Flip a coin", "do": {"kind": "tool", "tool": "coin"}, "phrases": ["(flip|toss) a coin", "coin (flip|toss)", "heads or tails"]},
    {"id": "tool.dice", "group": "Fun", "title": "Roll dice", "do": {"kind": "tool", "tool": "dice"}, "phrases": ["(roll|throw) (a|the) (die|dice)", "roll dice"]},
    {"id": "tool.dice_n", "group": "Fun", "title": "Roll several dice", "do": {"kind": "tool", "tool": "dice"}, "phrases": ["(roll|throw) {n} dice"], "examples": ["roll 3 dice"]},
    {"id": "tool.die_sides", "group": "Fun", "title": "Roll an N-sided die", "do": {"kind": "tool", "tool": "die_sides"}, "phrases": ["(roll|throw) a {n} sided (die|dice)"], "examples": ["roll a 20 sided die"]},
    {"id": "tool.card", "group": "Fun", "title": "Pick a card", "do": {"kind": "tool", "tool": "card"}, "phrases": ["(pick|draw) a card [any card]", "pick any card"]},
    {"id": "tool.rps", "group": "Fun", "title": "Rock paper scissors", "do": {"kind": "tool", "tool": "rps"}, "phrases": ["[let us] play rock paper scissors", "rock paper scissors [shoot]"]},
    {"id": "tool.magic8", "group": "Fun", "title": "Magic 8-ball", "do": {"kind": "tool", "tool": "magic8"}, "phrases": ["[ask the|shake the] magic (8|eight) ball"]},
    {"id": "tool.magic8_q", "group": "Fun", "title": "Ask the magic 8-ball", "do": {"kind": "tool", "tool": "magic8"}, "phrases": ["(ask the|magic) (8|eight) ball {q}", "ask the magic (8|eight) ball {q}"], "examples": ["ask the magic 8 ball will I win"]},
    {"id": "tool.yes_no", "group": "Fun", "title": "Yes or no", "do": {"kind": "tool", "tool": "yes_no"}, "phrases": ["[say|give me a] yes or no"]},
    {"id": "tool.choose", "group": "Fun", "title": "Choose between two", "do": {"kind": "tool", "tool": "choose"}, "phrases": ["(choose|pick|decide) between {a} (and|or) {b}", "should i (choose|pick|get|have) {a} or {b}"], "examples": ["choose between pizza and burger"]},
    {"id": "tool.spell", "group": "Words", "title": "Spell a word", "do": {"kind": "tool", "tool": "spell"}, "phrases": ["(how do you|how do i|how to) spell {w}", "spell {w}", "what is the spelling of {w}"], "examples": ["how do you spell necessary"]},
    {"id": "tool.letter_count", "group": "Words", "title": "Count letters", "do": {"kind": "tool", "tool": "letter_count"}, "phrases": ["how many letters (are in|in|does) [the word] {w} [have]", "count the letters in {w}"], "examples": ["how many letters in elephant"]},
    {"id": "tool.word_count", "group": "Words", "title": "Count words", "do": {"kind": "tool", "tool": "word_count"}, "phrases": ["how many words (are in|in) {q}", "count the words in {q}"], "examples": ["count the words in the quick brown fox"]},
    {"id": "tool.nato", "group": "Words", "title": "NATO phonetic spelling", "do": {"kind": "tool", "tool": "nato"}, "phrases": ["spell {w} (in|using) [the] (nato|phonetic) [alphabet]", "{w} in [the] (nato|phonetic) alphabet", "(nato|phonetic) alphabet for {w}"], "examples": ["spell echo in the nato alphabet"]},
    {"id": "tool.morse", "group": "Words", "title": "Morse code", "do": {"kind": "tool", "tool": "morse"}, "phrases": ["{w} in morse [code]", "(translate|convert|write) {w} (in|into|to) morse [code]", "morse code for {w}", "how do (you|i) say {w} in morse [code]"], "examples": ["sos in morse code"]},
    {"id": "tool.reverse", "group": "Words", "title": "Reverse a word", "do": {"kind": "tool", "tool": "reverse"}, "phrases": ["(spell|say|write) {w} backwards", "reverse [the word] {w}"], "examples": ["spell echo backwards"]},
    {"id": "tool.calc", "group": "Calculate & convert", "title": "Calculator", "do": {"kind": "tool", "tool": "calc"}, "phrases": ["(calculate|compute|what is|how much is|solve|what's) {e}", "what is the answer to {e}", "{e}"], "examples": ["what is 25 times 4", "calculate (12 + 8) * 3", "2 to the power of 10", "15 divided by 4"]}
  ]
}
